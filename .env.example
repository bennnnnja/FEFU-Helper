# Yandex Maps JS API v3 key (optional). Leave empty to use the free
# OpenStreetMap / Leaflet fallback (no key required).
# Get a free key at https://developer.tech.yandex.ru/ (enable
# "JavaScript API and Geocoder HTTP"). Paste it below and set
# USE_YANDEX_MAPS = true in src/components/MapView.tsx.
VITE_YANDEX_MAPS_KEY=
