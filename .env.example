# Yandex Maps JS API v3 key.
# Get a free key at https://developer.tech.yandex.ru/ (enable
# "JavaScript API and Geocoder HTTP"). Copy this file to .env and
# paste your key below.
#
# The map uses Yandex when USE_YANDEX_MAPS = true in
# src/components/MapView.tsx (the default). If the key is missing, the
# app automatically falls back to free OpenStreetMap / Leaflet.
VITE_YANDEX_MAPS_KEY=
